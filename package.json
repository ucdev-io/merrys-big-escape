{
  "name": "doggo",
  "private": true,
  "version": "0.8.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "demo": "vite build --mode demo --base /play/ --outDir dist-site/play --emptyOutDir",
    "site": "vite build -c site/vite.config.js && npm run demo",
    "site:dev": "vite -c site/vite.config.js --port 5183 --host",
    "preview": "vite preview",
    "play": "vite build && node server/index.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "lil-gui": "^0.21.0",
    "vite": "^8.3.8"
  }
}
